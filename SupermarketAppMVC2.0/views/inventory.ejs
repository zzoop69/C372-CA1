<!DOCTYPE html>
<html lang="en">
<%- include('partials/head', { title: 'Inventory' }) %>
<style>
  .products-overlay { background-color: transparent; padding: 24px 0; }
</style>
</head>
<body>
  <%- include('partials/adminnavbar', { user: user, cart: cart }) %>

  <div class="container">
    <div class="d-flex justify-content-end mt-3">
      <form class="d-flex" role="search" action="/inventory" method="GET">
        <input class="form-control" type="search" placeholder="Search products" aria-label="Search" name="q" value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>">
        <button class="btn btn-outline-primary ms-2" type="submit" title="Search">Search</button>
      </form>
    </div>

    <% if (lowStock && lowStock.length > 0) { %>
      <div class="alert alert-warning mt-3 w-auto" role="alert" style="max-width:600px; background-color: #f4a27a; border-color: #d65600; color:#663300; font-size:0.95rem;">
        <strong>Low Stock:</strong> The following items are below 40 units in inventory:
        <ul class="mb-0 mt-2">
          <% lowStock.forEach(item => { %>
            <li><a href="/product/<%= item.id %>"><%= item.productName %></a> — <strong><%= item.quantity %></strong> units</li>
          <% }) %>
        </ul>
      </div>
    <% } %>

    <div class="products-overlay">
    <p>Welcome, <%= user.username %> (<%= user.role %>)</p>
    <br>
    <div class="text-center"><h2>Products from Supermarket App Database</h2></div>
    <br>

    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-4">
      <% for(let i=0; i < products.length; i++) { %>
        <div class="col">
          <div class="card h-100">
            <a href="/product/<%= products[i].id %>">
              <img src="/images/<%= products[i].image %>" class="card-img-top" alt="<%= products[i].productName %>" style="height:200px; object-fit:cover;">
            </a>
            <div class="card-body d-flex flex-column">
              <h5 class="card-title"><a href="/product/<%= products[i].id %>" class="text-decoration-none text-dark"><%= products[i].productName %></a></h5>
              <p class="card-text mb-1" style="color: black;">Price: <strong>$<%= products[i].price.toFixed(2) %></strong></p>
              <p class="card-text text-muted">Available: <%= products[i].quantity %></p>

              <div class="mt-auto d-flex gap-2">
                <a href="/product/<%= products[i].id %>" class="btn btn-outline-primary btn-sm">View</a>
                <a href="/updateProduct/<%= products[i].id %>" class="btn btn-secondary btn-sm">Edit</a>
                <a href="/deleteProduct/<%= products[i].id %>" class="btn btn-danger btn-sm" onclick="return confirm('Are you sure you want to delete this product?')">Delete</a>
              </div>
            </div>
          </div>
        </div>
      <% } %>
    </div>
  </div>
</body>
</html>
