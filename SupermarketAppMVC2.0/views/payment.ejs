<!DOCTYPE html>
<html lang="en">
<%- include('partials/head', { title: 'Payment' }) %>
<style>
  .products-overlay { background-color: transparent; padding: 24px 0; color: inherit; }
  .products-overlay .list-group-item { background: #ffffff; color: #000000; border: 1px solid rgba(0,0,0,0.06); }
  .stripe-button {
    background: #635bff;
    color: #fff;
    border: 0;
    border-radius: 6px;
    padding: 20px 34px;
    font-weight: 600;
    min-width: 340px;
    box-shadow: 0 2px 6px rgba(0,0,0,0.12);
  }
  .stripe-button:hover { background: #4f46ff; }
  .stripe-button:disabled { opacity: 0.7; cursor: not-allowed; }
  .stripe-logo {
    display: inline-block;
    width: 24px;
    height: 24px;
    margin-right: 12px;
    border-radius: 4px;
    background: #fff;
    color: #635bff;
    font-weight: 700;
    line-height: 24px;
    text-align: center;
    font-size: 13px;
  }
  #paypal-button-container {
    min-width: 340px;
    max-width: 340px;
  }
</style>
</head>
<body>
  <%- include('partials/navbar', { user: user, cart: cart }) %>

  <div class="container mt-4">
    <div class="products-overlay">
      <h2>Payment</h2>
      <% const cartItems = cart || []; %>
      <% if (cartItems.length === 0) { %>
        <p>Your cart is empty.</p>
        <a href="/shopping" class="btn btn-secondary">Back to Shopping</a>
      <% } else { %>
        <ul class="list-group mb-3">
          <% let total = 0; %>
          <% cartItems.forEach(item => { %>
            <li class="list-group-item d-flex justify-content-between align-items-center">
              <div>
                <strong><%= item.productName %></strong>
                <div class="small">Qty: <%= item.quantity %> × $<%= item.price.toFixed(2) %></div>
              </div>
              <div>$<%= (item.price * item.quantity).toFixed(2) %></div>
            </li>
            <% total += item.price * item.quantity; %>
          <% }); %>
        </ul>
        <h4>Total: $<%= total.toFixed(2) %></h4>

        <div class="mb-3">
          <a href="/checkout" class="btn btn-secondary mt-1">Back to Checkout</a>
        </div>

        <div class="mt-4">
          <h5>Choose a payment method</h5>

          <!-- PayPal option -->
          <% if (typeof paypalClientId !== 'undefined' && paypalClientId) { %>
            <div id="paypal-button-container" class="mt-3"></div>
          <% } else { %>
            <div class="alert alert-warning mt-3">PayPal is not configured.</div>
          <% } %>

          <!-- Stripe option -->
          <% if (typeof stripePublishableKey !== 'undefined' && stripePublishableKey) { %>
            <% if (typeof paypalClientId !== 'undefined' && paypalClientId) { %>
              <div>OR</div>
            <% } %>
            <button id="stripeCheckoutBtn" class="stripe-button mt-3" type="button">
              <span class="stripe-logo">S</span>
              Stripe
            </button>
          <% } else { %>
            <div class="alert alert-warning mt-3">Stripe is not configured.</div>
          <% } %>
        </div>
      <% } %>
    </div>
  </div>
</body>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<% if (typeof stripePublishableKey !== 'undefined' && stripePublishableKey) { %>
  <script src="https://js.stripe.com/v3/"></script>
  <script>
    (function () {
      const btn = document.getElementById('stripeCheckoutBtn');
      if (!btn) return;
      const stripe = Stripe('<%= stripePublishableKey %>');
      btn.addEventListener('click', async (e) => {
        e.preventDefault();
        btn.disabled = true;
        const res = await fetch('/stripe/create-checkout-session', { method: 'POST', headers: { 'content-type': 'application/json' } });
        const data = await res.json();
        if (data && data.id) {
          const result = await stripe.redirectToCheckout({ sessionId: data.id });
          if (result && result.error) {
            alert(result.error.message || 'Stripe redirect failed');
            btn.disabled = false;
          }
        } else if (data && data.url) {
          window.location = data.url;
        } else {
          alert('Unable to start Stripe checkout');
          btn.disabled = false;
        }
      });
    })();
  </script>
<% } %>
<% if (typeof paypalClientId !== 'undefined' && paypalClientId) { %>
  <script src="https://www.paypal.com/sdk/js?client-id=<%= paypalClientId %>&currency=<%= process.env.PAYPAL_CURRENCY || 'USD' %>"></script>
  <script>
    (function () {
      if (!document.getElementById('paypal-button-container')) return;
      paypal.Buttons({
        style: { layout: 'horizontal', height: 55, shape: 'rect' },
        createOrder: function (data, actions) {
          return fetch('/paypal/create-order', { method: 'post', headers: { 'content-type': 'application/json' } }).then(r => r.json()).then(d => d.id);
        },
        onApprove: function (data, actions) {
          return fetch('/paypal/capture-order', { method: 'post', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ orderID: data.orderID }) }).then(r => r.json()).then(resp => {
            if (resp && resp.status === 'COMPLETED') {
              const toastHtml = `
                <div class="toast align-items-center text-white bg-success border-0 position-fixed top-0 end-0 m-3" role="alert" aria-live="assertive" aria-atomic="true">
                  <div class="d-flex">
                    <div class="toast-body">Payment successful — redirecting to order confirmation...</div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                  </div>
                </div>`;
              const wrapper = document.createElement('div');
              wrapper.innerHTML = toastHtml;
              document.body.appendChild(wrapper.firstElementChild);
              const toastEl = document.querySelector('.toast');
              const bsToast = new bootstrap.Toast(toastEl, { delay: 2000 });
              bsToast.show();
              setTimeout(() => { window.location = '/payment-success?orderId=' + resp.orderId; }, 1500);
            } else {
              window.location = '/cart?paymentFailed=1';
            }
          });
        },
        onError: function (err) { console.error('PayPal error', err); window.location = '/cart?paymentFailed=1'; }
      }).render('#paypal-button-container');
    })();
  </script>
<% } %>
</html>
