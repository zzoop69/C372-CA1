<!DOCTYPE html>
<html lang="en">
    <%- include('partials/head', { title: 'Edit Product' }) %>
    <style>
      form { color: #111; }
      .products-overlay { background-color: transparent; padding: 24px 0; }
    </style>
    </head>
<body>
    <%- include('partials/adminnavbar') %>

    <div class="bg-overlay products-overlay">
      <div class="container">
        <div class="edit-card card shadow-sm">
          <div class="card-body">
            <div class="text-center mb-3"><h2>Edit Product</h2></div>
            <% if (product) { %>
              <form action="/editProduct/<%= product.id %>" method="POST" enctype="multipart/form-data">
                <div class="mb-3">
                  <label for="name" class="form-label" class="text-white">Product Name</label>
                  <input type="text" id="name" name="name" class="form-control" value="<%= product.productName %>" required>
                </div>

                <div class="row g-3">
                  <div class="col-md-6">
                    <label for="quantity" class="form-label" class="text-white">Quantity</label>
                    <input type="number" id="quantity" name="quantity" class="form-control" min="0" step="1" value="<%= product.quantity %>" required>
                  </div>
                  <div class="col-md-6">
                    <label for="price" class="form-label" class="text-white">Price</label>
                    <input type="number" id="price" name="price" class="form-control" min="0" step="0.01" value="<%= product.price %>" required>
                  </div>
                </div>

                <div class="mt-3">
                  <label class="form-label" class="text-white">Current Image</label>
                  <input type="text" name="currentImage" class="form-control" value="<%= product.image %>" readonly>
                  <div class="mt-2">
                    <img src="/images/<%= product.image %>" class="img-fluid" style="max-height:120px; object-fit:cover;">
                  </div>
                </div>

                <div class="mt-3">
                  <label for="image" class="form-label" class="text-white">New Image</label>
                  <input type="file" id="image" name="image" accept="image/*" class="form-control">
                </div>

                <div class="mt-4 d-flex justify-content-between">
                  <a href="/" class="btn btn-secondary">Back</a>
                  <button type="submit" class="btn btn-primary">Update Product</button>
                </div>
              </form>
            <% } else { %>
              <p class="text-center">No product found.</p>
            <% } %>
          </div>
        </div>
      </div>
    </div>
</body>
</html>
