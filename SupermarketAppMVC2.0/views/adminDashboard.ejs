<!DOCTYPE html>
<html lang="en">
<%- include('partials/head', { title: 'Admin - Dashboard' }) %>
<style>
  body { background: #f7f8fb; }
  .card { border: none; box-shadow: 0 8px 24px rgba(15, 23, 42, 0.08); }
  .kpi-value { font-size: 2rem; font-weight: 700; }
  .muted { color: #6b7280; }
</style>
</head>
<body>
  <%- include('partials/adminnavbar', { user: user, cart: (typeof cart !== 'undefined' ? cart : null) }) %>

  <div class="container mt-4">
    <div class="d-flex align-items-center justify-content-between mb-3">
      <h2 class="mb-0">Admin Dashboard</h2>
      <span class="muted">Completed payments only</span>
    </div>

    <div class="row g-3">
      <div class="col-md-4">
        <div class="card p-3">
          <div class="muted">Total Revenue</div>
          <div class="kpi-value">$<%= Number(totalRevenue || 0).toFixed(2) %></div>
          <div class="d-flex gap-2 mt-2">
            <div class="muted small">Period: <%= (typeof currentPeriod !== 'undefined' && currentPeriod === 'daily') ? 'Last 30 days' : 'Last 12 months' %></div>
          </div>
          <div class="mt-2">
            <div class="small muted">Today: <strong>$<%= Number(todayRevenue || 0).toFixed(2) %></strong></div>
            <div class="small muted">Yesterday: <strong>$<%= Number(yesterdayRevenue || 0).toFixed(2) %></strong></div>
          </div>
        </div>
      </div>
      <div class="col-md-8">
        <div class="card p-3">
          <div class="d-flex justify-content-between align-items-center mb-2">
            <div>
              <div class="fw-semibold">Revenue Over Time</div>
              <div class="muted small">Aggregated by <%= (typeof currentPeriod !== 'undefined' && currentPeriod === 'daily') ? 'day' : 'month' %></div>
            </div>
            <div>
              <div class="btn-group btn-group-sm" role="group" aria-label="Period toggle">
                <a href="/admin/dashboard?period=daily" class="btn <%= (typeof currentPeriod !== 'undefined' && currentPeriod === 'daily') ? 'btn-primary' : 'btn-outline-secondary' %>">Daily</a>
                <a href="/admin/dashboard?period=monthly" class="btn <%= (typeof currentPeriod === 'undefined' || currentPeriod === 'monthly') ? 'btn-primary' : 'btn-outline-secondary' %>">Monthly</a>
              </div>
            </div>
          </div>
          <canvas id="revenueChart" height="120"
                  data-labels='<%- JSON.stringify(labels || []) %>'
                  data-values='<%- JSON.stringify(values || []) %>'></canvas>
        </div>
      </div>
    </div>
  </div>

  <div class="container mt-4">
    <div class="row">
      <div class="col-md-6">
        <div class="card p-3">
          <div class="d-flex justify-content-between align-items-center mb-2">
            <div>
              <div class="fw-semibold">Top Selling Items</div>
              <div class="muted small">Ranked by total quantity sold (descending)</div>
            </div>
          </div>
          <table class="table table-sm mt-2">
            <thead>
              <tr><th>#</th><th>Product</th><th class="text-end">Qty Sold</th></tr>
            </thead>
            <tbody>
              <% (popularItems || []).forEach((it, idx) => { %>
                <tr>
                  <td><%= idx + 1 %></td>
                  <td><%= it.productName %></td>
                  <td class="text-end"><%= it.total_sold %></td>
                </tr>
              <% }) %>
              <% if (!popularItems || popularItems.length === 0) { %>
                <tr><td colspan="3" class="text-center muted">No sales data available</td></tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
      <div class="col-md-6">
        <div class="card p-3">
          <div class="d-flex justify-content-between align-items-center mb-2">
            <div>
              <div class="fw-semibold">Least Selling Items</div>
              <div class="muted small">Lowest quantity sold (helpful for inventory decisions)</div>
            </div>
          </div>
          <table class="table table-sm mt-2">
            <thead>
              <tr><th>#</th><th>Product</th><th class="text-end">Qty Sold</th></tr>
            </thead>
            <tbody>
              <% (leastSelling || []).forEach((it, idx) => { %>
                <tr>
                  <td><%= idx + 1 %></td>
                  <td><%= it.productName %></td>
                  <td class="text-end"><%= it.total_sold %></td>
                </tr>
              <% }) %>
              <% if (!leastSelling || leastSelling.length === 0) { %>
                <tr><td colspan="3" class="text-center muted">No sales data available</td></tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <div class="container mt-4">
    <div class="row">
      <div class="col-md-6">
        <div class="card p-3">
          <div class="d-flex justify-content-between align-items-center mb-2">
            <div>
              <div class="fw-semibold">Highest Rated Items</div>
              <div class="muted small">Products with highest average customer ratings</div>
            </div>
          </div>
          <table class="table table-sm mt-2">
            <thead>
              <tr><th>#</th><th>Product</th><th class="text-end">Avg Rating</th><th class="text-end"># Reviews</th></tr>
            </thead>
            <tbody>
              <% (topRated || []).forEach((it, idx) => { %>
                <tr>
                  <td><%= idx + 1 %></td>
                  <td><%= it.productName %></td>
                  <td class="text-end"><%= it.avg_rating %></td>
                  <td class="text-end"><%= it.reviews_count %></td>
                </tr>
              <% }) %>
              <% if (!topRated || topRated.length === 0) { %>
                <tr><td colspan="4" class="text-center muted">No rating data available</td></tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
      <div class="col-md-6">
        <div class="card p-3">
          <div class="d-flex justify-content-between align-items-center mb-2">
            <div>
              <div class="fw-semibold">Lowest Rated Items</div>
              <div class="muted small">Products with lowest average customer ratings</div>
            </div>
          </div>
          <table class="table table-sm mt-2">
            <thead>
              <tr><th>#</th><th>Product</th><th class="text-end">Avg Rating</th><th class="text-end"># Reviews</th></tr>
            </thead>
            <tbody>
              <% (lowRated || []).forEach((it, idx) => { %>
                <tr>
                  <td><%= idx + 1 %></td>
                  <td><%= it.productName %></td>
                  <td class="text-end"><%= it.avg_rating %></td>
                  <td class="text-end"><%= it.reviews_count %></td>
                </tr>
              <% }) %>
              <% if (!lowRated || lowRated.length === 0) { %>
                <tr><td colspan="4" class="text-center muted">No rating data available</td></tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
  <script>
    const ctx = document.getElementById('revenueChart');
    if (ctx) {
      const labels = JSON.parse(ctx.dataset.labels || '[]');
      const values = JSON.parse(ctx.dataset.values || '[]');

      new Chart(ctx, {
        type: 'line',
        data: {
          labels,
          datasets: [{
            label: 'Revenue',
            data: values,
            borderColor: '#4f46e5',
            backgroundColor: 'rgba(79, 70, 229, 0.15)',
            fill: true,
            tension: 0.3,
            pointRadius: 3
          }]
        },
        options: {
          responsive: true,
          plugins: {
            legend: { display: false },
            tooltip: {
              callbacks: {
                label: (ctx) => `$${Number(ctx.parsed.y || 0).toFixed(2)}`
              }
            }
          },
          scales: {
            x: {
              title: { display: true, text: 'Time' }
            },
            y: {
              title: { display: true, text: 'Amount ($)' },
              beginAtZero: true,
              ticks: {
                callback: (v) => `$${Number(v).toFixed(0)}`
              }
            }
          }
        }
      });
    }
  </script>
</body>
</html>
